# --- ROS / Catkin / Colcon build artifacts ---
build/
devel/
install/
log/
logs/
build_isolated/
devel_isolated/
install_isolated/

# Catkin marker
CATKIN_IGNORE

# Generated ROS messages/services/actions
msg_gen/
srv_gen/
msg/*Action.msg
msg/*ActionFeedback.msg
msg/*ActionGoal.msg
msg/*ActionResult.msg
msg/*Feedback.msg
msg/*Goal.msg
msg/*Result.msg
msg/_*.py
srv/_*.py

# Dynamic reconfigure generated files
*.cfgc
/cfg/cpp/
/cfg/*.py

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
venv/
env/

# --- Docker / local environment ---
.env
.env.*
!.env.example

# --- IDE / editor files ---
.vscode/
.idea/
.project
.cproject
*.user
CMakeLists.txt.user
qtcreator-*
*~
.#*

# --- macOS / system files ---
.DS_Store
.AppleDouble
.LSOverride

# --- Logs / runtime output ---
*.log
*.pcd

# --- Generated docs ---
*.dox
*.wikidoc

# --- Project-specific generated folders ---
/planning/cfg/
/planning/docs/
/planning/src/

# --- Images and maps created ---
# Generated images
images/*
!images/.gitkeep

# Camera captures
captures/*
!captures/.gitkeep

# Maps
maps/*
!maps/.gitkeep
