FROM ros:jazzy-ros-base

WORKDIR /app

RUN apt-get update && apt-get install -y \
    python3-pip \
    python3-opencv \
    python3-numpy \
    python3-flask \
    && rm -rf /var/lib/apt/lists/*

RUN pip3 install --break-system-packages --no-cache-dir onnxruntime

COPY picam_server/ /app/

ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app

CMD ["bash", "-lc", "source /opt/ros/jazzy/setup.bash && python3 -u app_detect.py"]